# Copy to .env for local runs. Never commit real values.

# Render sets a PostgreSQL URL automatically; locally SQLite is fine.
DATABASE_URL=sqlite:///./patients.db
# Insert 2 demo patients when the table is empty.
SEED_DATA=true
# Optional shared secret for /vapi/webhook (see README, Security).
VAPI_SECRET=
LOG_LEVEL=INFO

# Only for scripts/setup_vapi.py (run on your laptop):
VAPI_API_KEY=
SERVER_URL=https://your-app.onrender.com
VAPI_MODEL=gpt-4o
